# URL publique canonique de l'application
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentification Google (OAuth personnalisé actuel, à migrer séparément)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Secret HMAC des sessions actuelles : 32 octets minimum en production
SESSION_SECRET=""
# Sel des empreintes de vues actuelles : 32 octets minimum en production
VIEW_HASH_SALT=""

# PostgreSQL / Neon — aucune connexion n'est créée tant que les repositories
# applicatifs n'ont pas été migrés. Ne pas utiliser de valeur factice en production.
# DATABASE_URL : endpoint poolé pour les connexions runtime.
DATABASE_URL=""
# DATABASE_MIGRATION_URL : endpoint direct (non poolé) recommandé pour Drizzle Kit.
DATABASE_MIGRATION_URL=""
DATABASE_POOL_MAX="5"

# Stockage objet S3 compatible pour les avatars en production
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="quelquemots"
S3_PREFIX="uploads"

# Variables de service existantes
GEMINI_API_KEY=""
CRON_SECRET=""
UPLOAD_DIR=".uploads"

# Upstash Redis en ligne pour le rate limiting partagé (repli PostgreSQL si absent)
# Créer la base sur https://upstash.com (tier gratuit), puis copier REST URL + token ici.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
