# Clé Gemini (facultative ; ne pas exposer au navigateur)
GEMINI_API_KEY=""

# URL canonique côté serveur et côté navigateur
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth Google (aucun compte de démonstration de repli)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# HMAC des cookies de session : au moins 32 octets, obligatoire en production
# Générer avec : openssl rand -hex 32
SESSION_SECRET=""

# Sel des empreintes de consultation : au moins 32 octets, obligatoire en production
# Générer indépendamment de SESSION_SECRET : openssl rand -hex 32
VIEW_HASH_SALT=""

# ATTENTION : la persistance PostgreSQL n'est PAS encore implémentée dans ce dépôt.
# Définir DATABASE_URL seul ne rendra pas les données persistantes.
DATABASE_URL=""
CRON_SECRET=""

# Stockage objet S3 compatible pour les avatars (obligatoire en production)
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="quelquemots"
S3_PREFIX="uploads"

# Stockage fichier local réservé au développement
UPLOAD_DIR=".uploads"
