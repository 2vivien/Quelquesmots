# GEMINI_API_KEY: Optionnel, géré par AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL d'hébergement de l'application (utilisée pour les appels SSR et OAuth)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mode réel : connexion Google OAuth (optionnel).
# Sans ces identifiants, /api/auth/signin/google ouvre une session de démonstration.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Secret de signature des sessions (OBLIGATOIRE en production)
SESSION_SECRET=""

# Poivre pour le hachage des vues uniques
VIEW_HASH_SALT=""

# PostgreSQL / Neon (réservé, non requis : le store réel est en mémoire)
DATABASE_URL=""
CRON_SECRET=""

# S3 compatible (Neon Object Storage, MinIO, AWS, Cloudflare R2…) pour la photo de profil
# Format AWS standard. Sans AWS_ENDPOINT_URL_S3, les avatars sont stockés sur disque local (`.uploads/`).
AWS_ENDPOINT_URL_S3="https://<projet>.storage.aws.neon.tech"
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="quelquemots"
S3_PREFIX="uploads"
# Repli rétrocompatible : S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
UPLOAD_DIR=".uploads"
